# Postgres connection string (Neon or any Postgres). Required.
DATABASE_URI="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Signs login cookies. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Admin portal password. /admin login is disabled while this is empty.
ADMIN_PASSWORD=""

# Public base URL, used for the manage-booking link in emails.
APP_URL="http://localhost:3000"

# Time zone the admin portal displays times in.
ADMIN_TIMEZONE="Asia/Kolkata"

# Optional SMTP transport, e.g. smtp://user:pass@smtp.example.com:587
# If empty, emails are only recorded in the email log (Admin > Emails).
SMTP_URL=""
EMAIL_FROM="Codeyoung <no-reply@codeyoung.example>"
