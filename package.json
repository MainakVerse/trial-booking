    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/luxon": "3.4.2",
    "@types/node": "20.14.10",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "tsx": "^4.16.2",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
